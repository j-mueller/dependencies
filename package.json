{
  "name": "dependency-graph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "concurrently --kill-others --names api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "dev:web": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:github": "tsx scripts/import-github.ts",
    "lint": "oxlint --deny-warnings",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@xyflow/react": "^12.11.5",
    "elkjs": "^0.12.0",
    "fastify": "^5.12.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
